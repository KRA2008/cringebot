<?xml version="1.0" encoding="utf-8" ?>
<fresh:FreshBaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                            xmlns:fresh="clr-namespace:FreshMvvm.Maui;assembly=FreshMvvm.Maui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                            xmlns:viewModel="clr-namespace:Cringebot.ViewModel;assembly=Cringebot.MAUI"
                            xmlns:vc="clr-namespace:Cringebot.Page.ValueConverters;assembly=Cringebot.MAUI"
                            xmlns:sfChart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
                            x:DataType="viewModel:ChartViewModel"
                            x:Class="Cringebot.Page.ChartPage"
                            Title="{Binding Title}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Button">
                <Setter Property="FontSize"
                        Value="12"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{DynamicResource statListIconName}"
                     Command="{Binding ViewStatsCommand}"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <StackLayout Padding="0"
                     Spacing="5">
            <Label Text="No data. Please add data."
                   IsVisible="{Binding IsDataPresent, Converter={vc:NotConverter}}"
                   Margin="15"/>
            <sfChart:SfCartesianChart HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     Margin="5,15,15,0"
                                     BackgroundColor="{DynamicResource styledPageBackgroundColor}"
                                     PaletteBrushes="{StaticResource styledChartColors}">
                <sfChart:SfCartesianChart.XAxes>
                    <sfChart:CategoryAxis LabelRotation="45">
                        <sfChart:CategoryAxis.AxisLineStyle>
                            <sfChart:ChartLineStyle Stroke="{StaticResource styledTextColor}"/>
                        </sfChart:CategoryAxis.AxisLineStyle>
                        <sfChart:CategoryAxis.MajorTickStyle>
                            <sfChart:ChartAxisTickStyle Stroke="{StaticResource styledTextColor}"/>
                        </sfChart:CategoryAxis.MajorTickStyle>
                        <sfChart:CategoryAxis.LabelStyle>
                            <sfChart:ChartAxisLabelStyle TextColor="{StaticResource styledTextColor}"/>
                        </sfChart:CategoryAxis.LabelStyle>
                        <sfChart:CategoryAxis.ShowMajorGridLines>
                            false
                        </sfChart:CategoryAxis.ShowMajorGridLines>
                    </sfChart:CategoryAxis>
                </sfChart:SfCartesianChart.XAxes>
                <sfChart:SfCartesianChart.YAxes>
                    <sfChart:NumericalAxis>
                        <sfChart:NumericalAxis.MajorTickStyle>
                            <sfChart:ChartAxisTickStyle Stroke="{StaticResource styledTextColor}"/>
                        </sfChart:NumericalAxis.MajorTickStyle>
                        <sfChart:NumericalAxis.MajorGridLineStyle>
                            <sfChart:ChartLineStyle Stroke="{StaticResource styledTextColor}"/>
                        </sfChart:NumericalAxis.MajorGridLineStyle>
                        <sfChart:NumericalAxis.AxisLineStyle>
                            <sfChart:ChartLineStyle Stroke="{StaticResource styledTextColor}"/>
                        </sfChart:NumericalAxis.AxisLineStyle>
                        <sfChart:NumericalAxis.LabelStyle>
                            <sfChart:ChartAxisLabelStyle TextColor="{StaticResource styledTextColor}"/>
                        </sfChart:NumericalAxis.LabelStyle>
                        <sfChart:NumericalAxis.Title>
                            <sfChart:ChartAxisTitle Text="Cringes"
                                                    TextColor="{StaticResource styledTextColor}"/>
                        </sfChart:NumericalAxis.Title>
                    </sfChart:NumericalAxis>
                </sfChart:SfCartesianChart.YAxes>
                <sfChart:SfCartesianChart.Series>
                    <sfChart:ColumnSeries ItemsSource="{Binding Data}"
                                          XBindingPath="Name"
                                          YBindingPath="Count"/>
                </sfChart:SfCartesianChart.Series>
            </sfChart:SfCartesianChart>
            <StackLayout Orientation="Horizontal"
                         Padding="15,0,15,0">
                <Button Command="{Binding SetLast7DaysCommand}"
                        Text="Last 7 Days"
                        HorizontalOptions="CenterAndExpand"/>
                <Button Command="{Binding SetLast30DaysCommand}"
                        Text="Last 30 Days"
                        HorizontalOptions="CenterAndExpand"/>
                <Button Command="{Binding SetLast52WeeksCommand}"
                        Text="Last 52 Weeks"
                        HorizontalOptions="CenterAndExpand"/>
            </StackLayout>
            <StackLayout Orientation="Horizontal"
                         Padding="15,0,15,15">
                <Button Command="{Binding SetTimeOfDayCommand}"
                        Text="Time of Day"
                        HorizontalOptions="CenterAndExpand"/>
                <Button Command="{Binding SetDayOfWeekCommand}"
                        Text="Day of Week"
                        HorizontalOptions="CenterAndExpand"/>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</fresh:FreshBaseContentPage>